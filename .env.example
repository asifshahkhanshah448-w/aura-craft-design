# Database configuration
# Set your MongoDB Atlas connection string below:
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/aura_ecommerce?retryWrites=true&w=majority"

# JWT Secret for signing authentication tokens
JWT_SECRET="<your_jwt_secret_key_here>"
JWT_EXPIRES_IN="7d"

# Server Port (for standalone Express server)
PORT=5000

# Base URL for frontend API calls
NEXT_PUBLIC_API_URL="/api"
